index 10c2dba..d6c86a7 100644
--- a/sfall/main.cpp
+++ b/sfall/main.cpp
@@ -23,6 +23,7 @@
 #include <algorithm>
 #include <stdio.h>
 #include <memory>
+#include <string>
 
 #include "FalloutEngine\Fallout2.h"
 #include "ModuleManager.h"
@@ -261,6 +262,45 @@ static void CompatModeCheck(HKEY root, const char* filepath, int extra) {
 	}
 }
 
+static std::wstring olympusFolder;
+
+static void LoadOlympusKoreanFont() {
+	const auto dllPath = olympusFolder + L"fallout2font.dll";
+	const HMODULE font = LoadLibraryExW(dllPath.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+	const auto init = font ? reinterpret_cast<void (__cdecl*)()>(
+	    GetProcAddress(font, "InitOlympusKoreanFromSfall")) : nullptr;
+	if (init) init();
+	else MessageBoxW(nullptr, L"Cannot load the Olympus Korean font module.",
+	                 L"Olympus 2207 Korean", MB_OK | MB_ICONERROR);
+}
+
+static void ConfigureOlympusKorean() {
+	wchar_t file[MAX_PATH];
+	const DWORD size = GetModuleFileNameW(nullptr, file, MAX_PATH);
+	if (!size || size == MAX_PATH) return;
+	olympusFolder.assign(file, size);
+	olympusFolder.resize(olympusFolder.find_last_of(L"\\/") + 1);
+
+	const auto text = olympusFolder + L"data\\text\\korean\\dialog\\tiptext.msg";
+	if (GetFileAttributesW(text.c_str()) == INVALID_FILE_ATTRIBUTES) return;
+
+	char config[64];
+	if (!GetConfigString("Misc", "ConfigFile", "", config, sizeof(config)) ||
+	    _stricmp(config, "olympus.cfg") != 0) {
+		MessageBoxW(nullptr, L"Restore the original Olympus ddraw.ini and try again.",
+		            L"Olympus 2207 Korean", MB_OK | MB_ICONERROR);
+		return;
+	}
+	const auto cfg = olympusFolder + L"olympus.cfg";
+	if (GetFileAttributesW(cfg.c_str()) == INVALID_FILE_ATTRIBUTES ||
+	    !WritePrivateProfileStringW(L"system", L"language", L"korean", cfg.c_str())) {
+		MessageBoxW(nullptr, L"Cannot set the language in olympus.cfg.",
+		            L"Olympus 2207 Korean", MB_OK | MB_ICONERROR);
+		return;
+	}
+	LoadGameHook::OnAfterGameInit() += LoadOlympusKoreanFont;
+}
+
 inline void SfallInit() {
 	// enabling debugging features
 	isDebug = (iniGetInt("Debugging", "Enable", 0, ::sfall::ddrawIni) != 0);
