+// Extended sfall checks the original Olympus executable CRC before startup.
+extern "C" __declspec(dllexport) void __cdecl InitOlympusKoreanFromSfall() {
+    constexpr BYTE host[] = {0x83, 0x3D, 0xDC, 0x94, 0x51, 0x00, 0x00};
